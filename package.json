{
  "name": "gitlab-tools",
  "version": "2.15.4",
  "description": "CLI utility for batch operations on GitLab repositories: reports, cloning, topics, publishing, and local working copy manipulations.",
  "main": "./build/main/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint ./src/** --fix",
    "install-globally": "npm install && npm run rebuild && npm install -g ./",
    "rebuild": "rm -Rf ./build/* && tsc && chmod +x ./build/main/index.js && touch .env"
  },
  "bin": {
    "gitlab-tools": "./build/main/index.js",
    "gtlz": "./build/main/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.8",
    "dotenv": "^16.4.5",
    "enquirer": "^2.4.1",
    "ora": "^8.2.0",
    "winston": "^3.13.0",
    "yargs": "^17.7.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^7.5.1",
    "@types/axios": "^0.14.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.2",
    "@types/yargs": "^17.0.32",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.57.1",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "ts-jest": "^25.5.1",
    "typescript": "^5.4.3",
    "typescript-eslint": "^7.3.1"
  },
  "allowScripts": {
    "unrs-resolver@1.11.1": true,
    "@parcel/watcher@2.6.0": true
  }
}
